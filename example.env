# Copy to .env and fill in. .env is gitignored; src/secrets.h is generated
# from it by tools/gen_secrets.py before every build.

# From @BotFather.
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Only messages from this chat are paged; everything else is ignored.
# Send the bot a message and read the chat id from the serial log, or ask
# @userinfobot.
BOT_CHAT_ID=0

WIFI_SSID=my-network
WIFI_PASSWORD=my-password

# Hours added to the device's UTC clock for the [HH:MM] stamp. 3 = Moscow.
TZ_OFFSET_HOURS=3

# Language of the text the firmware itself shows and of the receipts it sends
# back to the chat: english (default) or russian. Message text and sender names
# always come through from Telegram as-is, in whatever language they were sent.
UI_LANGUAGE=english

# ---- Proxy (optional) ---------------------------------------------------
# none   -- connect straight to api.telegram.org
# socks5 -- tunnel the HTTPS connection through a SOCKS5 proxy
#
# MTProto proxies are deliberately not supported: they relay Telegram's client
# protocol, not the plain HTTPS the Bot API needs, so they cannot carry this
# traffic at all. Use SOCKS5.
PROXY_TYPE=none
#PROXY_HOST=1.2.3.4
#PROXY_PORT=1080
# Leave both unset for an open proxy; set both for username/password auth.
#PROXY_USER=user
#PROXY_PASS=secret
